        "parameters": [
          {
            "name": "Variants",
            "in": "query",
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/VariantCreateDto"
              }
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "required": [
                  "CategoryId",
                  "Description",
                  "Name"
                ],
                "type": "object",
                "properties": {
                  "Name": {
                    "maxLength": 150,
                    "minLength": 0,
                    "type": "string"
                  },
                  "Description": {
                    "type": "string"
                  },
                  "BasePrice": {
                    "maximum": 1000000,
                    "minimum": 0.01,
                    "type": "number",
                    "format": "double"
                  },
                  "DiscountPercentage": {
                    "maximum": 100,
                    "minimum": 0,
                    "type": "number",
                    "format": "double"
                  },
                  "CategoryId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "Images": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "binary"
                    },
                    "description": "Upload binary image files directly from your device"
                  },
                  "ImageTargetSkus": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "ImageIsPrimary": {
                    "type": "array",
                    "items": {
                      "type": "boolean"
                    }
                  }
                }
              },
              "encoding": {
                "Name": {
                  "style": "form"
                },
                "Description": {
                  "style": "form"
                },
                "BasePrice": {
                  "style": "form"
                },
                "DiscountPercentage": {
                  "style": "form"
                },
                "CategoryId": {
                  "style": "form"
                },
                "Images": {
                  "style": "form"
                },
                "ImageTargetSkus": {
                  "style": "form"
                },
                "ImageIsPrimary": {
                  "style": "form"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
