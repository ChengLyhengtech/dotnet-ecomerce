  "components": {
    "schemas": {
      "AddToCartDto": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "productVariantId": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "AddToWishlistDto": {
        "type": "object",
        "properties": {
          "productId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "additionalProperties": false
      },
      "BannerPosition": {
        "enum": [
          1,
          2,
          3,
          4
        ],
        "type": "integer",
        "format": "int32"
      },
      "GoogleLoginDto": {
        "required": [
          "idToken"
        ],
        "type": "object",
        "properties": {
          "idToken": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "OrderCreateDto": {
        "required": [
          "contactPhone",
          "deliveryLatitude",
          "deliveryLongitude",
          "items"
        ],
        "type": "object",
        "properties": {
          "contactPhone": {
            "minLength": 1,
            "type": "string"
          },
          "shippingAddress": {
            "type": "string",
            "nullable": true
          },
          "deliveryLatitude": {
            "type": "number",
            "format": "double"
          },
          "deliveryLongitude": {
            "type": "number",
            "format": "double"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderItemCreateDto"
            }
          }
        },
        "additionalProperties": false
      },
      "OrderItemCreateDto": {
        "required": [
          "variantId"
        ],
        "type": "object",
        "properties": {
          "variantId": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "maximum": 100,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "ProductUpdateDto": {
        "required": [
          "categoryId",
          "description",
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 150,
            "minLength": 0,
            "type": "string"
          },
          "description": {
            "minLength": 1,
            "type": "string"
          },
          "basePrice": {
            "maximum": 1000000,
            "minimum": 0.01,
            "type": "number",
            "format": "double"
          },
          "discountPercentage": {
            "maximum": 100,
            "minimum": 0,
            "type": "number",
            "format": "double"
          },
          "categoryId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "additionalProperties": false
      },
      "TelegramLoginDto": {
        "required": [
          "first_Name",
          "hash"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
